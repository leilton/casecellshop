# Git flow: main and develop only change through pull requests.
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ] || [ "$branch" = "develop" ]; then
  if [ "$ALLOW_PROTECTED_PUSH" != "1" ]; then
    echo "Direct push to '$branch' is blocked. Open a pull request from a feature/release/hotfix branch."
    echo "(Maintainers finishing a release/hotfix: ALLOW_PROTECTED_PUSH=1 git push ...)"
    exit 1
  fi
fi
