# Copy to .env and adjust. Every value has a default in docker-compose.yml.
LOG_LEVEL=info

# Simulated ERP chaos (also adjustable at runtime: POST http://localhost:4000/admin/config)
ERP_LATENCY_MS=300
ERP_JITTER_MS=200
ERP_ERROR_RATE=0.1
ERP_TIMEOUT_RATE=0.05
ERP_INVOICE_LATENCY_MS=1500
ERP_TIMEOUT_MS=2000

# TTLs per data type: ERP catalog entry (names + prices, bounded by price) and our stock
CACHE_TTL_PRICE_S=60
CACHE_TTL_STOCK_S=5
CACHE_STALE_IF_ERROR_S=120

# Checkout reservation and worker timings
RESERVATION_TTL_S=900            # how long unpaid stock stays reserved before reconciliation cancels it
CATALOG_SYNC_INTERVAL_MS=10000   # how often the worker polls the ERP catalog (price change visibility)
RECONCILE_INTERVAL_MS=30000      # how often expired reservations / stuck invoicing are re-checked
INVOICING_STUCK_AFTER_S=120      # INVOICING orders idle this long are looked up in the ERP
INVOICING_LEASE_S=15             # must exceed ERP_TIMEOUT_MS: blocks concurrent duplicate deliveries

WORKER_CONCURRENCY=5
WORKER_MAX_ATTEMPTS=5
K6_SKU=CASE-IPH15-BLK
