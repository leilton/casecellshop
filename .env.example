# Copy to .env and adjust. Every value has a default in docker-compose.yml.
LOG_LEVEL=info

# Simulated ERP chaos (also adjustable at runtime: POST http://localhost:4000/admin/config)
ERP_LATENCY_MS=300
ERP_JITTER_MS=200
ERP_ERROR_RATE=0.1
ERP_TIMEOUT_RATE=0.05
ERP_INVOICE_LATENCY_MS=1500
ERP_TIMEOUT_MS=2000

# TTLs per data type: ERP catalog entry (names + prices, bounded by price) and our stock
CACHE_TTL_PRICE_S=60
CACHE_TTL_STOCK_S=5
CACHE_STALE_IF_ERROR_S=120

WORKER_CONCURRENCY=5
WORKER_MAX_ATTEMPTS=5
K6_SKU=CASE-IPH15-BLK
