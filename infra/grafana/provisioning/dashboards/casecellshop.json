      "id": 14,
      "type": "timeseries",
      "title": "Queue depth (main / DLQ)",
      "description": "Main backlog > 100 for 5 min and any DLQ message are critical alerts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
