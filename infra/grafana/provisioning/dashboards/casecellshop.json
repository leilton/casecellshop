          "refId": "A",
          "expr": "sum by (outcome) (rate(checkout_requests_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Reservation conflicts by SKU",
      "description": "Out-of-stock rejections. A spike on one SKU = a rush (or a bot) on that product.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (sku) (rate(stock_reservation_conflicts_total[5m]))",
          "legendFormat": "{{sku}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Inventory available by SKU",
      "description": "Must never go below 0 (alert PossibleOverselling).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
