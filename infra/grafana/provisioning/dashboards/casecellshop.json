                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "inventory_available",
          "legendFormat": "{{sku}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Queue, worker and ERP",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
