    {
      "id": 15,
      "type": "timeseries",
      "title": "Orders reaching a final status",
      "description": "FAILED = invoicing exhausted (stock released). CANCELLED = reservation expired without invoice.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (final_status) (increase(order_processing_duration_seconds_count[5m]))",
          "legendFormat": "{{final_status}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "ERP calls by operation and outcome",
      "description": "",
